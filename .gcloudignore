# Respect repository exclusions as a baseline.
#!include:.gitignore

.git
.git/**

.env
.env.*
!.env.example

node_modules
node_modules/**
.next
.next/**
coverage
coverage/**

.firebase
.firebase/**
firebase-debug.log
firestore-debug.log
ui-debug.log
*.log

firestore-export
firestore-export/**
firestore-export-*
emulator-data
emulator-data/**
emulator-export
emulator-export/**

tmp
tmp/**
temp
temp/**

screenshots
screenshots/**
chrome-*.png
*-screenshot.png

service-account*.json
firebase-admin*.json
credentials*.json
application_default_credentials.json
*.pem
*.key
*.p12
